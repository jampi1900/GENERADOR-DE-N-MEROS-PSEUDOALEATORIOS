class Varianza:
    def __init__(self):
        self.a = 0.05 
    
    def probar(self, archivo):
        
         # Leer el archivo manualmente
        with open(archivo, 'r') as file:
            contenido = file.read()
        
        # Dividir el contenido por espacios y convertir a números flotantes
        datos = [float(valor) for valor in contenido.split()]
        varianza = stats.variance(datos)
        
        n = len(datos) - 1 
        
        B = (12 * n )
        
        CHIA = chi2.ppf((self.a/2), n)
        CHIB = chi2.ppf((1-(self.a/2)), n)
        
        print (CHIA)
        print (CHIB)
        
        LI = CHIA / B  
        LS = CHIB / B  
        
        
        print(f"LI es: {LI}")
        print(f"LS es: {LS}")
        print(f"La varianza es: {varianza}")
              # Retornar si la media está dentro del intervalo
        return LI <= varianza <= LS
      

