class chi_cuadrado:
    def __init__(self, mm):
        self.a = 0.05 
        self.mm = mm  # los bins
    
    def probar(self, archivo):
        # Leer el archivo manualmente
        with open(archivo, 'r') as file:
            contenido = file.read()
        
        # Dividir el contenido por espacios y convertir a números flotantes
        datos = [float(valor) for valor in contenido.split()]
        
        n = len(datos)
        
        
        
        # Definir la cantidad de intervalos (por ejemplo, 4 o 10)
        cantidad_intervalos = self.mm
        m = cantidad_intervalos
        E = n / m  # Valor esperado

        # Crear los límites de los intervalos entre 0.0 y 1.0
        limites = np.linspace(0.0, 1.0, cantidad_intervalos + 1)

        # Crear los intervalos o bins con el rango de 0 a 1
        intervalos = pd.cut(datos, bins=limites, right=True)

        # Contar cuántos números caen en cada intervalo
        conteo_por_intervalo = intervalos.value_counts().sort_index()

        # Crear un DataFrame para almacenar los resultados
        resultados = pd.DataFrame({
            'Intervalo': conteo_por_intervalo.index,
            'Oi': conteo_por_intervalo.values,
            'Ei': E
        })

        # Calcular (Ei - Oi)**2 / Ei
        resultados['(Ei - Oi)**2 / Ei'] = ((resultados['Ei'] - resultados['Oi']) ** 2) / resultados['Ei']

        # Mostrar el DataFrame final
        print(resultados)

        # Sumar los valores calculados para obtener el valor del estadístico chi-cuadrado
        total = sum(resultados['(Ei - Oi)**2 / Ei'])
        print(f"Valor calculado de Chi-cuadrado: {total}")
        
        # Calcular el valor crítico de Chi-cuadrado
        CHI = chi2.ppf(1 - self.a, m - 1)
        print(f"Valor crítico de Chi-cuadrado: {CHI}")

        return total, CHI


