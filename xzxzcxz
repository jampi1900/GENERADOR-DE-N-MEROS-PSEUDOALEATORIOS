class Independencia:
    def __init__(self):
        self.a = 0.05 

    def probar(self, archivo):
        # Leer el archivo manualmente
        try:
            with open(archivo, 'r') as file:
                contenido = file.read()
            
            # Dividir el contenido por espacios y convertir a números flotantes
            datos = [float(valor) for valor in contenido.split()]

            n = len(datos)
            print(f"Número de datos: {n}")

            # Lista para almacenar los estados (0 o 1)
            estados = []

            # Comparar cada número con el siguiente
            for i in range(n - 1):
                if datos[i + 1] > datos[i]:
                    estados.append(1)
                else:
                    estados.append(0)

            # Contar cambios de estado
            cambios_de_estado = 1  # Iniciar en 1 si hay al menos un cambio
