            print(f"Número de estados: {n1}")

            for i in range(len(estados) - 1):  # Usar len(estados) - 1
                if estados[i] != estados[i + 1]:  # Si el estado cambia
                    cambios_de_estado += 1

            # Cálculos
            u = ((2 * n) - 1) / 3
            print(f"Valor de u: {u}")

            o = (16 * n - 29) / 90
            o2 = math.sqrt(o)
            print(f"Desviación estándar o2: {o2}")

            resultado = (cambios_de_estado - u) / o2
            print(f"Resultado final: {resultado}")

            print(f"Estados: {estados}")
            print(f"Cambios de estado: {cambios_de_estado}")
            
            from scipy.stats import norm

            # Definir el nivel de significancia
            alpha = 0.05

            # Calcular z_(alpha/2) usando la función inversa (ppf) de la distribución normal
            z_alpha_2 = norm.ppf(alpha/2)
            
            

            print(f"El valor crítico z_(alpha/2) es: {z_alpha_2:.4f}")


